/*
 * FractiSynth φ Wavefield Console — procedural, multi-feed OBS *source* shader.
 *
 * Generates one of several SELECTABLE synthetic feeds from scratch (no input
 * image), each driven live by the El Gran Sol Gateway telemetry:
 *   feed 0  Wavefield Console — golden grid + lock ring + φ-spiral + fringes + hex + core
 *   feed 1  Hex Tunnel        — log-polar honeycomb tunnel zooming with the solar wind
 *   feed 2  Interference Field— two rotating K_EGS wave systems → holographic moiré
 *   feed 3  Spectral Rings    — outward rainbow bands pulsing with flux/lock
 *   feed 4  Spiral Drift      — drifting golden-spiral arms, density by lock
 *   feed 5  Telemetry HUD     — CPU-rendered in fractisynth.c
 *   feed 6  Solar Graph       — CPU-rendered in fractisynth.c
 * Post: optional hue-cycle (trippy) + chromatic shimmer (radial RGB split).
 *
 * NOTE: OBS does NOT initialise global `static const float3`; all palette colours
 * are built LOCALLY (see get_palette()).
 */

uniform float4x4 ViewProj;

uniform float swo_phase;
uniform float lock_strength;
uniform float wind_phase;
uniform float egs_key;
uniform float audio_rms;
uniform float audio_peak;
uniform float audio_reactivity;
uniform float elapsed;
uniform float2 uv_size;

uniform float feed;          /* 0..6 feed selector */
uniform float chroma;        /* chromatic shimmer intensity  */
uniform float hue_cycle;     /* hue rotation amount over time */
uniform float theme;         /* 0 Observatory, 1 Laboratory, 2 Expedition */
uniform float anim_speed;
uniform float intensity;
uniform float fringe_density;
uniform float show_ring;
uniform float show_spiral;
uniform float show_fringes;
uniform float show_grid;
uniform float show_hex;
uniform float show_dot;
uniform float show_tabs;     /* clickable target strip/rail (interactive) */
uniform float layer_visible_mask;
uniform float marker_x;
uniform float marker_y;
uniform float marker_age;

#define PHI 1.61803398875
#define INV_PHI 0.61803398875
#define TWO_PI 6.28318530718

struct VertData { float4 pos : POSITION; float2 uv : TEXCOORD0; };
struct Palette { float3 bg; float3 ring; float3 mari; float3 hot; float3 core; };

VertData VSDefault(VertData v_in)
{
	VertData o;
	o.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	o.uv = v_in.uv;
	return o;
}

Palette get_palette()
{
	Palette p;
	if (theme < 0.5) {            /* Observatory */
		p.bg = float3(0.118, 0.114, 0.094); p.ring = float3(0.227, 0.686, 0.663);
		p.mari = float3(0.910, 0.639, 0.239); p.hot = float3(0.910, 0.192, 0.227);
		p.core = float3(0.937, 0.914, 0.863);
	} else if (theme < 1.5) {     /* Laboratory */
		p.bg = float3(0.063, 0.082, 0.125); p.ring = float3(0.357, 0.722, 0.949);
		p.mari = float3(0.553, 0.804, 1.000); p.hot = float3(0.451, 0.553, 0.949);
		p.core = float3(0.878, 0.949, 1.000);
	} else {                      /* Expedition */
		p.bg = float3(0.137, 0.098, 0.078); p.ring = float3(0.949, 0.620, 0.247);
		p.mari = float3(0.980, 0.776, 0.302); p.hot = float3(0.922, 0.247, 0.176);
		p.core = float3(1.000, 0.929, 0.804);
	}
	return p;
}

float soft_line(float d, float w) { return 1.0 - smoothstep(0.0, w, abs(d)); }

float feed_enabled(float f)
{
	float idx = floor(f + 0.5);
	float bit = floor(layer_visible_mask / pow(2.0, idx));
	return step(1.0, fmod(bit, 2.0));
}

float hex_edge(float2 p)
{
	float2 a0 = float2(1.0, 0.0), a1 = float2(-0.5, 0.8660254), a2 = float2(-0.5, -0.8660254);
	float m = min(abs(frac(dot(p, a0)) - 0.5), min(abs(frac(dot(p, a1)) - 0.5), abs(frac(dot(p, a2)) - 0.5)));
	return smoothstep(0.03, 0.0, m);
}

/* YIQ-matrix hue rotation. */
float3 hue_rotate(float3 c, float a)
{
	float u = cos(a), w = sin(a);
	float3x3 m = float3x3(
		0.299 + 0.701 * u + 0.168 * w, 0.587 - 0.587 * u + 0.330 * w, 0.114 - 0.114 * u - 0.497 * w,
		0.299 - 0.299 * u - 0.328 * w, 0.587 + 0.413 * u + 0.035 * w, 0.114 - 0.114 * u + 0.292 * w,
		0.299 - 0.300 * u + 1.250 * w, 0.587 - 0.588 * u - 1.050 * w, 0.114 + 0.886 * u - 0.203 * w);
	return mul(m, c);
}

/* ---- feed 0: the Wavefield Console ---- */
float3 feed_wavefield(float2 uv, float t, float lock, float pn, float inten, float aspect)
{
	Palette p = get_palette();
	float2 c = (uv - 0.5); c.x *= aspect;
	float audio = clamp(audio_reactivity, 0.0, 1.0);
	c *= 1.0 + audio * 0.04 * sin(t * TWO_PI + length(c) * 18.0);
	float r = length(c); float ang = atan2(c.y, c.x);
	float3 col = lerp(p.bg, p.bg * 1.4, uv.y);

	float k = max(fringe_density, 1.0);
	float fr = cos(r * k - t * 0.5) + cos(r * k - wind_phase);
	float fint = fr * fr * 0.25;
	col += p.ring * fint * 0.10 * lock * show_fringes * inten;
	col = lerp(col, p.hot, fint * lock * 0.18 * show_fringes * inten);

	if (show_hex > 0.5) col = lerp(col, p.ring, hex_edge(c * 14.0) * (0.25 + 0.4 * lock) * inten);

	float lw = 1.6 / uv_size.x;
	float g = soft_line(uv.x - INV_PHI, lw) * 0.7 + soft_line(uv.y - INV_PHI, lw) * 0.5 + soft_line(uv.y - (1.0 - INV_PHI), lw) * 0.5;
	col = lerp(col, p.ring * 0.75, saturate(g) * show_grid * inten);

	float spiral = sin(ang * PHI - log(max(r, 1e-3)) / log(PHI) * TWO_PI + t * 0.3);
	col = lerp(col, p.mari, soft_line(spiral, 0.06) * smoothstep(0.0, 0.05, r) * (0.25 + 0.5 * pn) * show_spiral * inten);

	float onRing = 1.0 - smoothstep(0.012, 0.024, abs(r - 0.34));
	float arc = step((ang + 3.14159265) / TWO_PI, lock);
	col = lerp(col, lerp(p.hot, p.ring, lock), onRing * (0.15 + arc * 0.85) * show_ring * inten);
	float audioRing = 1.0 - smoothstep(0.010, 0.026, abs(r - (0.16 + 0.22 * clamp(audio_peak, 0.0, 1.0))));
	col = lerp(col, p.hot, audioRing * audio * 0.42 * inten);

	col = lerp(col, p.core, (1.0 - smoothstep(0.012, 0.022, r)) * (0.3 + 0.7 * pn) * show_dot);
	return col;
}

/* ---- feed 1: Hex Tunnel ---- */
float3 feed_hex_tunnel(float2 uv, float t, float lock, float pn, float inten, float aspect)
{
	Palette p = get_palette();
	float2 c = (uv - 0.5); c.x *= aspect;
	float r = length(c); float ang = atan2(c.y, c.x);
	float u = log(max(r, 1e-3)) * 3.0 - (t * 0.4 + wind_phase * 0.1);
	float edge = hex_edge(float2(ang / TWO_PI * 12.0, u * 2.0));
	float depth = smoothstep(0.0, 0.55, r);
	float audio = clamp(audio_reactivity, 0.0, 1.0);
	float3 col = lerp(p.bg, p.ring, edge * depth * (0.4 + 0.6 * lock) * inten);
	col += p.mari * pow(saturate(1.0 - r * 1.6), 3.0) * (0.4 + 0.6 * lock + 0.5 * audio) * inten;  /* centre glow */
	return col;
}

/* ---- feed 2: Interference Field (holographic moiré) ---- */
float3 feed_interference(float2 uv, float t, float lock, float pn, float inten, float aspect)
{
	Palette p = get_palette();
	float2 c = (uv - 0.5); c.x *= aspect;
	float k = max(fringe_density, 1.0) * 2.0;
	float a1 = wind_phase, a2 = wind_phase + 1.0472 + t * 0.05;
	float w1 = cos(dot(c, float2(cos(a1), sin(a1))) * k - t * 0.4);
	float w2 = cos(dot(c, float2(cos(a2), sin(a2))) * k + t * 0.3);
	float m = w1 + w2; float fi = m * m * 0.25;
	float audio = clamp(audio_reactivity, 0.0, 1.0);
	float3 col = lerp(p.bg, p.ring, fi * (0.5 + 0.5 * lock + 0.35 * audio) * inten);
	col = lerp(col, p.hot, pow(fi, 3.0) * lock * inten);
	col += p.mari * 0.12 * (lock + audio) * inten * (0.5 + 0.5 * sin(fi * TWO_PI + t));
	return col;
}

/* ---- feed 3: Spectral Rings ---- */
float3 feed_spectral(float2 uv, float t, float lock, float pn, float inten, float aspect)
{
	Palette p = get_palette();
	float2 c = (uv - 0.5); c.x *= aspect;
	float r = length(c);
	float audio = clamp(audio_reactivity, 0.0, 1.0);
	float bands = 8.0 + lock * 8.0 + audio * 4.0;
	float pos = r * bands - t * 0.3;
	float ringf = frac(pos);
	float idx = floor(pos);
	float3 spec = 0.5 + 0.5 * cos(TWO_PI * (idx * 0.13 + pn) + float3(0.0, 2.094, 4.188));
	float band = smoothstep(0.0, 0.10, ringf) * smoothstep(1.0, 0.90, ringf);
	float3 col = lerp(p.bg, spec, band * (0.4 + 0.6 * lock) * inten);
	return col;
}

/* ---- feed 4: Spiral Drift ---- */
float3 feed_spiral_drift(float2 uv, float t, float lock, float pn, float inten, float aspect)
{
	Palette p = get_palette();
	float2 c = (uv - 0.5); c.x *= aspect;
	float r = length(c); float ang = atan2(c.y, c.x);
	float audio = clamp(audio_reactivity, 0.0, 1.0);
	float arms = 5.0 + audio;
	float s = sin(ang * arms - log(max(r, 1e-3)) / log(PHI) * TWO_PI + t * 0.6);
	float3 col = lerp(p.bg, p.mari, smoothstep(0.6, 1.0, s) * (0.3 + 0.7 * lock) * inten);
	col += p.ring * pow(s * 0.5 + 0.5, 4.0) * 0.3 * (lock + audio) * inten;
	col = lerp(col, p.core, (1.0 - smoothstep(0.01, 0.02, r)) * (0.3 + 0.7 * pn));
	return col;
}

float3 feed_color(float2 uv)
{
	float t = elapsed * max(anim_speed, 0.0);
	float lock = clamp(lock_strength, 0.0, 1.0);
	float pn = clamp(swo_phase / 200.0, 0.0, 1.0);
	float audio = clamp(audio_reactivity, 0.0, 1.0);
	float inten = clamp(intensity * (1.0 + 0.35 * audio), 0.0, 1.35);
	float aspect = uv_size.x / max(uv_size.y, 1.0);
	if (feed < 0.5) return feed_wavefield(uv, t, lock, pn, inten, aspect);
	if (feed < 1.5) return feed_hex_tunnel(uv, t, lock, pn, inten, aspect);
	if (feed < 2.5) return feed_interference(uv, t, lock, pn, inten, aspect);
	if (feed < 3.5) return feed_spectral(uv, t, lock, pn, inten, aspect);
	if (feed > 4.5) return get_palette().bg * 0.35; /* CPU-rendered feeds bypass shader */
	return feed_spiral_drift(uv, t, lock, pn, inten, aspect);
}

float4 PSConsole(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float3 col;
	if (chroma > 0.001) {
		/* radial RGB split — the "chromatic shimmer" */
		float2 off = (uv - 0.5) * chroma * 0.03;
		col = float3(feed_color(uv + off).r, feed_color(uv).g, feed_color(uv - off).b);
	} else {
		col = feed_color(uv);
	}
	if (hue_cycle > 0.001)
		col = hue_rotate(col, hue_cycle * elapsed * 0.25);

	Palette p = get_palette();
	col = lerp(p.bg * 0.2, col, feed_enabled(feed));

	if (marker_age > 0.0 && marker_age < 4.0) {
		float fade = 1.0 - marker_age / 4.0;
		float2 d = uv - float2(marker_x, marker_y);
		float line = soft_line(d.x, 2.5 / uv_size.x) * step(abs(d.y), 0.035)
			+ soft_line(d.y, 2.5 / uv_size.y) * step(abs(d.x), 0.035);
		float ring = soft_line(length(d) - 0.030, 2.0 / uv_size.x);
		col = lerp(col, p.mari, saturate(line + ring) * fade);
	}

	/* clickable feed-selector tab strip across the top (7 cells; active = ring) */
	if (show_tabs > 0.5 && uv.y < 0.055) {
		float fcell = uv.x * 7.0;
		float is_on = step(abs(floor(fcell) - feed), 0.5);
		float3 tab = lerp(p.bg * 1.7, p.ring, is_on * 0.85);
		float seam = step(frac(fcell), 0.012) + step(0.988, frac(fcell));
		tab = lerp(tab, p.mari, saturate(seam));
		col = lerp(tab, col, smoothstep(0.05, 0.055, uv.y)); /* hairline bottom edge */
	}
	if (show_tabs > 0.5 && uv.x < 0.030 && uv.y >= 0.090) {
		float rail = frac((uv.y - 0.090) / 0.910 * 7.0);
		col = lerp(col, p.mari, (step(rail, 0.05) + step(0.95, rail)) * 0.45);
	}
	if (show_tabs > 0.5 && uv.y > 0.955) {
		float react = clamp(audio_reactivity, 0.0, 1.0);
		float rms = clamp(audio_rms, 0.0, 1.0);
		float peak = clamp(audio_peak, 0.0, 1.0);
		float meter = step(uv.x, max(react, rms));
		float peakLine = soft_line(uv.x - peak, 1.5 / uv_size.x);
		/* A real meter: a dark OPAQUE track (so the animated feed can't bleed
		 * through and swamp the level) with a bright φ-ring fill. High contrast
		 * keeps the level readable on any feed and makes silent-vs-signal an
		 * unambiguous delta for the live verifier. */
		float3 track = p.bg * 0.25;
		col = lerp(col, track, 0.92);
		col = lerp(col, p.ring, meter * 0.90);
		col = lerp(col, p.core, peakLine);
	}
	return float4(saturate(col), 1.0);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSConsole(v_in);
	}
}

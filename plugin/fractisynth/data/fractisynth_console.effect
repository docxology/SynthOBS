/*
 * FractiSynth φ Wavefield Console — a procedural, fully-configurable OBS *source*
 * shader. Generates the SynthOBS console from scratch (no input image): the
 * Goldilocks golden-ratio grid, a φ spiral, K_EGS-spaced holographic interference
 * fringes, a honeycomb hex lattice, a gateway lock ring, and a phase-vector core —
 * each independently toggleable, themed, and intensity-scaled by the source's OBS
 * properties, and driven live by the El Gran Sol Gateway uniforms.
 *
 * NOTE: OBS's effect language does NOT initialise global `static const float3`
 * constants at runtime (they read back zero → black), so all palette colours are
 * built as LOCAL float3() inside the pixel shader.
 */

uniform float4x4 ViewProj;

uniform float swo_phase;        /* SWO system_phase_vector (>0 when locked)   */
uniform float lock_strength;    /* [0,1] gateway lock |cos(wind phase bias)|  */
uniform float wind_phase;       /* radians, gateway phase bias                */
uniform float egs_key;          /* K_EGS ≈ 2.539427                           */
uniform float elapsed;          /* seconds                                    */
uniform float2 uv_size;         /* console size in pixels                     */

/* --- user configuration --- */
uniform float theme;            /* 0 Observatory, 1 Laboratory, 2 Expedition  */
uniform float anim_speed;       /* animation rate multiplier                  */
uniform float intensity;        /* master overlay intensity [0,1]             */
uniform float fringe_density;   /* interference spatial frequency             */
uniform float show_ring;
uniform float show_spiral;
uniform float show_fringes;
uniform float show_grid;
uniform float show_hex;
uniform float show_dot;

#define PHI 1.61803398875
#define INV_PHI 0.61803398875
#define TWO_PI 6.28318530718

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float soft_line(float d, float w)
{
	return 1.0 - smoothstep(0.0, w, abs(d));
}

/* honeycomb hex edge factor (three 120° tri-axes) */
float hex_edge(float2 p)
{
	float2 a0 = float2(1.0, 0.0);
	float2 a1 = float2(-0.5,  0.8660254);
	float2 a2 = float2(-0.5, -0.8660254);
	float f0 = abs(frac(dot(p, a0)) - 0.5);
	float f1 = abs(frac(dot(p, a1)) - 0.5);
	float f2 = abs(frac(dot(p, a2)) - 0.5);
	float m = min(f0, min(f1, f2));
	return smoothstep(0.03, 0.0, m);
}

float4 PSConsole(VertData v_in) : TARGET
{
	/* ---- theme palette (LOCAL colours) ---- */
	float3 BG, RING, MARI, HOT, CORE;
	if (theme < 0.5) {            /* Observatory — robin's-egg / marigold */
		BG   = float3(0.118, 0.114, 0.094);
		RING = float3(0.227, 0.686, 0.663);
		MARI = float3(0.910, 0.639, 0.239);
		HOT  = float3(0.910, 0.192, 0.227);
		CORE = float3(0.937, 0.914, 0.863);
	} else if (theme < 1.5) {    /* Laboratory — cool blue */
		BG   = float3(0.063, 0.082, 0.125);
		RING = float3(0.357, 0.722, 0.949);
		MARI = float3(0.553, 0.804, 1.000);
		HOT  = float3(0.451, 0.553, 0.949);
		CORE = float3(0.878, 0.949, 1.000);
	} else {                     /* Expedition — solar marigold / ember */
		BG   = float3(0.137, 0.098, 0.078);
		RING = float3(0.949, 0.620, 0.247);
		MARI = float3(0.980, 0.776, 0.302);
		HOT  = float3(0.922, 0.247, 0.176);
		CORE = float3(1.000, 0.929, 0.804);
	}

	float t = elapsed * max(anim_speed, 0.0);
	float lock = clamp(lock_strength, 0.0, 1.0);
	float phaseNorm = clamp(swo_phase / 200.0, 0.0, 1.0);
	float inten = clamp(intensity, 0.0, 1.0);

	float2 uv = v_in.uv;
	float aspect = uv_size.x / max(uv_size.y, 1.0);
	float2 c = (uv - 0.5);
	c.x *= aspect;
	float r = length(c);
	float ang = atan2(c.y, c.x);

	/* ---- background gradient ---- */
	float3 col = lerp(BG, BG * 1.4, uv.y);

	/* ---- holographic interference fringes (|a+b|², density-tunable) ---- */
	float k = max(fringe_density, 1.0);
	float beamA = cos(r * k - t * 0.5);
	float beamB = cos(r * k - wind_phase);
	float fr = beamA + beamB;
	float fint = fr * fr * 0.25;
	col += RING * fint * 0.10 * lock * show_fringes * inten;
	col = lerp(col, HOT, fint * lock * 0.18 * show_fringes * inten);

	/* ---- honeycomb hex lattice ---- */
	if (show_hex > 0.5) {
		float edge = hex_edge(c * 14.0);
		col = lerp(col, RING, edge * (0.25 + 0.4 * lock) * inten);
	}

	/* ---- Goldilocks golden-ratio grid (61.8 / 38.2) ---- */
	float lw = 1.6 / uv_size.x;
	float g = soft_line(uv.x - INV_PHI, lw) * 0.7
		+ soft_line(uv.y - INV_PHI, lw) * 0.5
		+ soft_line(uv.y - (1.0 - INV_PHI), lw) * 0.5;
	col = lerp(col, RING * 0.75, saturate(g) * show_grid * inten);

	/* ---- φ spiral ---- */
	float spiral = sin(ang * PHI - log(max(r, 1e-3)) / log(PHI) * TWO_PI + t * 0.3);
	float spiralLine = soft_line(spiral, 0.06) * smoothstep(0.0, 0.05, r);
	col = lerp(col, MARI, spiralLine * (0.25 + 0.5 * phaseNorm) * show_spiral * inten);

	/* ---- gateway lock ring (arc sweep = lock) ---- */
	float onRing = 1.0 - smoothstep(0.012, 0.024, abs(r - 0.34));
	float frac = (ang + 3.14159265) / TWO_PI;
	float arc = step(frac, lock);
	float3 ringCol = lerp(HOT, RING, lock);
	col = lerp(col, ringCol, onRing * (0.15 + arc * 0.85) * show_ring * inten);

	/* ---- phase-vector core ---- */
	float dot = 1.0 - smoothstep(0.012, 0.022, r);
	col = lerp(col, CORE, dot * (0.3 + 0.7 * phaseNorm) * show_dot);

	return float4(saturate(col), 1.0);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSConsole(v_in);
	}
}

  "claims": [
    {
      "id": "OBS-001",
      "class": "interface-contract",
      "statement": "The native integration is evaluated at the documented libobs module boundary and through the obs-websocket capture protocol.",
      "sources": ["obsmodules", "obswebsocket"],
      "source_of_truth": ["plugin/fractisynth/src/fractisynth.c", "scripts/obs_scenario_probe.py"],
      "tests": ["tests/test_plugin_artifacts.py", "tests/test_obs_scenario_probe.py"],
      "artifacts": ["manuscript/assets/obs/obs_manifest.json", "output/figures/plugin_lifecycle.png"]
    },
    {
      "id": "TEL-001",
      "class": "external-context",
      "statement": "Telemetry provenance is tied to named NOAA products and transferred by libcurl; malformed, stale, or non-finite payloads fail closed.",
      "sources": ["noaaswpc", "noaaf107", "noaasunspot", "noaartsw", "libcurl"],
      "source_of_truth": ["src/synthobs/telemetry.py", "plugin/fractisynth/src/fractisynth.c"],
      "tests": ["tests/test_telemetry.py", "tests/test_solar_series.py", "tests/test_fail_closed_fuzz.py"],
      "artifacts": ["manuscript/assets/obs/obs_manifest.json", "output/figures/telemetry_pipeline.png"]
    },
    {
      "id": "REP-001",
      "class": "design-proposition",
      "statement": "Versioned inputs, deterministic generators, explicit commands, and separated live gates make this artifact inspectable and rerunnable within stated boundaries.",
      "sources": ["nasem2019", "wilson2014", "sandve2013", "wilkinson2016fair"],
      "source_of_truth": ["manuscript/08_evaluation_reproducibility.md", "scripts/generate_figures.py"],
      "tests": ["tests/test_docs_contracts.py"],
      "artifacts": ["output/figures/figure_manifest.json", "manuscript/assets/obs/obs_manifest.json"]
    },
    {
      "id": "CITE-001",
      "class": "design-proposition",
      "statement": "SynthOBS treats its versioned source, metadata, and evidence bundle as a citable software object: repository location identifies the live project, while the release version and future archive record identify the specific scholarly object used.",
      "sources": ["smith2016softwarecitation", "cffschema"],
      "source_of_truth": ["CITATION.cff", "RELEASE.md", "README.md", "docs/scholarship.md"],
      "tests": ["tests/test_docs_contracts.py"],
      "artifacts": ["CITATION.cff", "manuscript/08_evaluation_reproducibility.md"]
    },
    {
      "id": "PROV-001",
      "class": "interface-contract",
      "statement": "The live evidence bundle records asset hashes, capture metadata, and a checksum-verifiable telemetry strip; it detects corruption but is not a keyed authenticity claim.",
      "sources": ["wilkinson2016fair", "prov2013"],
      "source_of_truth": ["src/synthobs/provenance.py", "scripts/verify_provenance_strip.py"],
      "tests": ["tests/test_provenance.py", "tests/test_provenance_verify_tool.py"],
      "artifacts": ["manuscript/assets/obs/obs_manifest.json", "manuscript/assets/obs/obs_telemetry_hud.png"]
    },
    {
      "id": "FIG-001",
      "class": "interface-contract",
      "statement": "Analytical figures are generated from labelled source functions and accompanied by a machine-readable manifest rather than treated as decorative evidence.",
      "sources": ["hunter2007matplotlib"],
      "source_of_truth": ["scripts/generate_figures.py"],
      "tests": ["tests/test_docs_contracts.py"],
      "artifacts": ["output/figures/figure_manifest.json", "output/figures/architecture_layers.png"]
    },
    {
      "id": "GEO-001",
      "class": "design-proposition",
      "statement": "Golden-ratio geometry is a declared design choice implemented as exact integer partitions and tested for coverage, gap, and overlap invariants.",
      "sources": ["livio2002golden"],
      "source_of_truth": ["src/synthobs/constants.py", "src/synthobs/layout.py"],
      "tests": ["tests/test_constants_and_layout.py"],
      "artifacts": ["output/figures/goldilocks_layout.png", "output/figures/golden_split.png"]
    },
    {
      "id": "DSP-001",
      "class": "design-proposition",
      "statement": "The phi-knee limiter and spatial scale matrix are engineering constructions bounded and compared across Python and native implementations.",
      "sources": ["smith2007"],
      "source_of_truth": ["src/synthobs/dsp.py", "plugin/fractisynth/src/fractisynth.c"],
      "tests": ["tests/test_swo_and_dsp.py", "tests/test_c_parity_behavioral.py"],
      "artifacts": ["output/figures/phi_soft_limiter.png", "output/figures/phi_matrix.png"]
    },
    {
      "id": "ARCH-001",
      "class": "design-proposition",
      "statement": "The separation between a dependency-free reference engine, native runtime mirror, and I/O-oriented scripts is an explicit architecture choice.",
      "sources": ["gamma1994"],
      "source_of_truth": ["AGENTS.md", "src/synthobs", "plugin/fractisynth", "scripts"],
      "tests": ["tests/test_docs_contracts.py", "tests/test_plugin_artifacts.py"],
      "artifacts": ["output/figures/architecture_layers.png", "output/figures/parity_bridge.png"]
    },
    {
      "id": "SPECT-001",
      "class": "external-context",
      "statement": "The H-alpha visual anchor is labelled as a wavelength provenance reference, not as evidence that the overlay measures solar spectroscopy.",
      "sources": ["nisthalpha"],
      "source_of_truth": ["plugin/fractisynth/data/fractisynth.effect", "manuscript/00_abstract.md"],
      "tests": ["tests/test_gateway_and_interference.py"],
      "artifacts": ["output/figures/obs_scene_render.png"]
    }
  ]
